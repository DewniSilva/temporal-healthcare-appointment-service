# Local-development placeholders only. Use a secret manager in production.
DATABASE_URL=postgresql://healthcare_app:local_app_password@postgres:5432/healthcare?schema=public
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=healthcare-appointments
# Set to true for a self-hosted Temporal cluster with TLS. Leave false for the
# plaintext local Compose network.
TEMPORAL_TLS=false
# Set for Temporal Cloud (or any server using API-key auth); also implies TLS.
TEMPORAL_API_KEY=
# Required in production: getEnv() refuses to start with this literal demo
# value once NODE_ENV=production, so a real deployment must supply its own.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
PORT=3000
CORS_ORIGIN=http://localhost:3000
REMINDER_LEAD_TIME_SECONDS=7200
# Create a key at https://resend.com/api-keys. Required: reminders fail (workflow FAILED,
# notification FAILED) rather than being silently marked as sent when this is blank.
RESEND_API_KEY=
# onboarding@resend.dev is suitable for initial testing; verify your own domain for production sending.
RESEND_FROM_EMAIL=Healthcare Appointments <onboarding@resend.dev>
# Demo users have non-deliverable example.test addresses, so use your real test inbox here.
# Required alongside RESEND_API_KEY, for the same reason.
REMINDER_EMAIL_TO=you@example.com
LOG_LEVEL=info
# Demo-only failure injection: none | notification-once | create-permanent
DEMO_FAILURE_MODE=none
# Backs the HTTP rate limiters so limits are correct across multiple backend replicas.
REDIS_URL=redis://redis:6379
# How often the reconciliation Workflow sweeps for orphaned/stuck state.
RECONCILIATION_INTERVAL_MINUTES=15
# How long past an appointment's own end time before its leftover state (an
# unreleased slot reservation, a still-BOOKED row) is treated as stale.
ORPHANED_RESERVATION_GRACE_MINUTES=60
