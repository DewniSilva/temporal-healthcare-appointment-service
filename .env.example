# Local-development placeholders only. Use a secret manager in production.
DATABASE_URL=postgresql://healthcare_app:local_app_password@postgres:5432/healthcare?schema=public
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=healthcare-appointments
# Set to true for a self-hosted Temporal cluster with TLS. Leave false for the
# plaintext local Compose network.
TEMPORAL_TLS=false
# Set for Temporal Cloud (or any server using API-key auth); also implies TLS.
TEMPORAL_API_KEY=
# Optional client-certificate mTLS files (mounted secrets); cert and key must be set together.
TEMPORAL_TLS_CLIENT_CERT_PATH=
TEMPORAL_TLS_CLIENT_KEY_PATH=
TEMPORAL_TLS_CA_PATH=
TEMPORAL_TLS_SERVER_NAME=
# Required in production: getEnv() refuses to start with this literal demo
# value once NODE_ENV=production, so a real deployment must supply its own.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
JWT_ISSUER=temporal-healthcare-appointments
JWT_AUDIENCE=temporal-healthcare-users
PORT=3000
CORS_ORIGIN=http://localhost:3000
# IANA zone the clinic's recurring doctor schedules are defined in (wall
# clock, e.g. "Monday 8am"). One clinic-wide zone for now.
CLINIC_TIMEZONE=Asia/Colombo
# Confirmation/reminder policy: 24h confirmation reminder, 6h confirmation
# deadline (BOOKED -> NO_RESPONSE if unanswered), 2h upcoming reminder (only
# if CONFIRMED). Each must be strictly smaller than the one before it.
CONFIRMATION_REMINDER_HOURS_BEFORE=24
CONFIRMATION_DEADLINE_HOURS_BEFORE=6
UPCOMING_REMINDER_HOURS_BEFORE=2
# Only RELEASE_SLOT is implemented today.
NO_RESPONSE_POLICY=RELEASE_SLOT
# Resend Activity retry ceiling (1 initial attempt + 4 retries by default).
REMINDER_MAX_ATTEMPTS=5
# Create a key at https://resend.com/api-keys. Required: reminders fail (Reminder
# status FAILED) rather than being silently marked as sent when this is blank.
RESEND_API_KEY=
# onboarding@resend.dev is suitable for initial testing; verify your own domain for production sending.
RESEND_FROM_EMAIL=Healthcare Appointments <onboarding@resend.dev>
# Demo patients have non-deliverable example.test addresses. When set, this
# overrides the patient's on-file email for every reminder so a real inbox
# receives them (Resend's sandbox mode restricts delivery to one verified
# recipient anyway). Leave blank in a real deployment to send to the actual
# patient address.
REMINDER_EMAIL_TO=you@example.com
LOG_LEVEL=info
# Metrics stay local to the container on port 9464. Tracing is opt-in and uses OTLP/HTTP.
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
METRICS_PORT=9464
TEMPORAL_METRICS_PORT=9465
OTEL_ENABLED=false
OTEL_SERVICE_NAME=temporal-healthcare-appointments
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Demo-only failure injection: none | notification-once | create-permanent
DEMO_FAILURE_MODE=none
# Backs the HTTP rate limiters so limits are correct across multiple backend replicas.
REDIS_URL=redis://redis:6379
# Set this to the exact number of trusted reverse proxies/load balancers in
# front of Express. Keep zero for direct local access so clients cannot spoof
# X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Redis-backed endpoint-specific fixed-window limits.
RATE_LIMIT_LOGIN_IP_MAX=5
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=900
RATE_LIMIT_BOOKING_MAX=10
RATE_LIMIT_BOOKING_WINDOW_SECONDS=60
RATE_LIMIT_CONFIRM_MAX=20
RATE_LIMIT_CONFIRM_WINDOW_SECONDS=60
RATE_LIMIT_CANCEL_MAX=20
RATE_LIMIT_CANCEL_WINDOW_SECONDS=60
RATE_LIMIT_MANAGEMENT_MAX=30
RATE_LIMIT_MANAGEMENT_WINDOW_SECONDS=60
# How often the reconciliation Workflow sweeps for orphaned/stuck state.
RECONCILIATION_INTERVAL_MINUTES=15
# How long past an appointment's own end time before its leftover state (an
# unreleased slot reservation, a still-BOOKED row) is treated as stale.
ORPHANED_RESERVATION_GRACE_MINUTES=60
# Caps rows fetched per reconciliation query per sweep so one pass can't
# balloon its Workflow history; a larger backlog is drained over several sweeps.
RECONCILIATION_BATCH_SIZE=100
