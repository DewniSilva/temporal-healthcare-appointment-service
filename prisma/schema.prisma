generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  REQUESTED
  RESERVING
  BOOKED
  CONFIRMED
  NO_RESPONSE
  CANCELLED
  COMPLETED
  NO_SHOW
  REJECTED
  BOOKING_FAILED
}

enum ReservationStatus {
  RESERVING
  RESERVED
  RELEASED
  CONFLICTED
}

enum ReminderType {
  CONFIRMATION_REMINDER
  UPCOMING_REMINDER
}

enum ReminderStatus {
  SCHEDULED
  PENDING
  SENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  CANCELLED
}

enum ActorRole {
  PATIENT
  DOCTOR
  ADMIN
  SYSTEM
}

enum DoctorScheduleExceptionType {
  UNAVAILABLE
  CUSTOM_HOURS
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  role         UserRole
  patient      Patient?
  doctor       Doctor?
  createdAt    DateTime @default(now())
}

model Patient {
  id           String        @id
  displayName  String
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]
}

model Doctor {
  id                 String                    @id
  displayName        String
  userId             String                    @unique
  user               User                      @relation(fields: [userId], references: [id])
  appointments       Appointment[]
  reservations       SlotReservation[]
  availability       DoctorAvailability[]
  scheduleExceptions DoctorScheduleException[]
}

model Appointment {
  id                         String            @id
  patientId                  String
  doctorId                   String
  appointmentTime            DateTime
  // Wall-clock UTC offset (minutes) captured from the original booking
  // request, e.g. "+05:30" -> 330. There is no stored IANA zone, so reminder
  // emails render against this fixed offset rather than a DST-aware zone.
  appointmentTzOffsetMinutes Int
  status                     AppointmentStatus @default(REQUESTED)
  confirmedAt                DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  patient                    Patient           @relation(fields: [patientId], references: [id])
  doctor                     Doctor            @relation(fields: [doctorId], references: [id])
  reservation                SlotReservation?
  reminders                  Reminder[]
  auditLogs                  AuditLog[]

  @@index([patientId])
  @@index([appointmentTime])
  @@index([status])
}

model SlotReservation {
  appointmentId    String            @id
  doctorId         String
  appointmentTime  DateTime
  status           ReservationStatus @default(RESERVING)
  overlapProtected Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  doctor           Doctor            @relation(fields: [doctorId], references: [id])
  appointment      Appointment       @relation(fields: [appointmentId], references: [id])

  // Exact-start protection is represented here. A customized PostgreSQL
  // exclusion constraint in the migration also rejects 20-minute overlaps,
  // scoped to status = RESERVED (see migration.sql).
  @@unique([doctorId, appointmentTime])
  @@index([status])
}

model Reminder {
  id                String         @id @default(cuid())
  appointmentId     String
  type              ReminderType
  status            ReminderStatus @default(SCHEDULED)
  // Deterministic, e.g. "appointment-{id}-confirmation-reminder". Reused
  // as the Resend idempotency key across retries and reconciliation.
  idempotencyKey    String         @unique
  providerMessageId String?
  attemptCount      Int            @default(0)
  scheduledAt       DateTime
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  lastError         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  appointment       Appointment    @relation(fields: [appointmentId], references: [id])

  // One logical reminder per appointment and type makes retries idempotent.
  @@unique([appointmentId, type])
  @@index([status])
}

model AuditLog {
  id            String      @id @default(cuid())
  appointmentId String
  actorId       String?
  actorRole     ActorRole
  action        String
  previousState String?
  newState      String
  correlationId String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
}

// A doctor's recurring weekly schedule, in clinic-local wall-clock time
// (see CLINIC_TIMEZONE) — not UTC, since "Monday 8am" must stay 8am
// regardless of what UTC offset that translates to on a given date.
// Multiple rows per (doctorId, dayOfWeek) represent multiple windows in one
// day (e.g. a lunch break split); no separate "break" concept is needed.
model DoctorAvailability {
  id        String   @id @default(cuid())
  doctorId  String
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday, clinic-local
  startTime String // "HH:mm", clinic-local wall clock
  endTime   String // "HH:mm", clinic-local wall clock
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id])

  @@index([doctorId, dayOfWeek])
}

// A one-off override for a single clinic-local calendar date: either the
// doctor is UNAVAILABLE (the whole day, or just [startTime,endTime) if those
// are set — e.g. a half-day emergency leave), or CUSTOM_HOURS replaces that
// date's recurring windows entirely (startTime/endTime required).
model DoctorScheduleException {
  id        String                      @id @default(cuid())
  doctorId  String
  date      DateTime                    @db.Date // clinic-local calendar date, no time component
  type      DoctorScheduleExceptionType
  startTime String? // "HH:mm", required for CUSTOM_HOURS; optional partial-day bound for UNAVAILABLE
  endTime   String?
  reason    String?
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  doctor    Doctor                      @relation(fields: [doctorId], references: [id])

  // At most one exception per doctor per date keeps precedence unambiguous.
  @@unique([doctorId, date])
}

// Clinic-wide closures (public holidays, planned shutdowns). Deliberately
// clinic-wide rather than per-clinic — see DoctorScheduleException for the
// per-doctor equivalent. A clinicId can be added here later without
// reshaping this table if multi-clinic support is ever needed.
model ClinicClosure {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  isClosed  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
