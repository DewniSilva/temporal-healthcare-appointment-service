generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  REQUESTED
  RESERVING
  BOOKED
  CONFIRMED
  NO_RESPONSE
  CANCELLED
  COMPLETED
  NO_SHOW
  REJECTED
  BOOKING_FAILED
}

enum ReservationStatus {
  RESERVING
  RESERVED
  RELEASED
  CONFLICTED
}

enum ReminderType {
  CONFIRMATION_REMINDER
  UPCOMING_REMINDER
}

enum ReminderStatus {
  SCHEDULED
  PENDING
  SENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  CANCELLED
}

enum ActorRole {
  PATIENT
  DOCTOR
  ADMIN
  SYSTEM
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  role         UserRole
  patient      Patient?
  doctor       Doctor?
  createdAt    DateTime @default(now())
}

model Patient {
  id           String        @id
  displayName  String
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]
}

model Doctor {
  id           String            @id
  displayName  String
  userId       String            @unique
  user         User              @relation(fields: [userId], references: [id])
  appointments Appointment[]
  reservations SlotReservation[]
}

model Appointment {
  id                         String            @id
  patientId                  String
  doctorId                   String
  appointmentTime            DateTime
  // Wall-clock UTC offset (minutes) captured from the original booking
  // request, e.g. "+05:30" -> 330. There is no stored IANA zone, so reminder
  // emails render against this fixed offset rather than a DST-aware zone.
  appointmentTzOffsetMinutes Int
  status                     AppointmentStatus @default(REQUESTED)
  confirmedAt                DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  patient                    Patient           @relation(fields: [patientId], references: [id])
  doctor                     Doctor            @relation(fields: [doctorId], references: [id])
  reservation                SlotReservation?
  reminders                  Reminder[]
  auditLogs                  AuditLog[]

  @@index([patientId])
  @@index([appointmentTime])
  @@index([status])
}

model SlotReservation {
  appointmentId    String            @id
  doctorId         String
  appointmentTime  DateTime
  status           ReservationStatus @default(RESERVING)
  overlapProtected Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  doctor           Doctor            @relation(fields: [doctorId], references: [id])
  appointment      Appointment       @relation(fields: [appointmentId], references: [id])

  // Exact-start protection is represented here. A customized PostgreSQL
  // exclusion constraint in the migration also rejects 20-minute overlaps,
  // scoped to status = RESERVED (see migration.sql).
  @@unique([doctorId, appointmentTime])
  @@index([status])
}

model Reminder {
  id                String         @id @default(cuid())
  appointmentId     String
  type              ReminderType
  status            ReminderStatus @default(SCHEDULED)
  // Deterministic, e.g. "appointment-{id}-confirmation-reminder". Reused
  // as the Resend idempotency key across retries and reconciliation.
  idempotencyKey    String         @unique
  providerMessageId String?
  attemptCount      Int            @default(0)
  scheduledAt       DateTime
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  lastError         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  appointment       Appointment    @relation(fields: [appointmentId], references: [id])

  // One logical reminder per appointment and type makes retries idempotent.
  @@unique([appointmentId, type])
  @@index([status])
}

model AuditLog {
  id            String      @id @default(cuid())
  appointmentId String
  actorId       String?
  actorRole     ActorRole
  action        String
  previousState String?
  newState      String
  correlationId String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
}
