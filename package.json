{
  "name": "temporal-healthcare-appointments",
  "version": "1.0.0",
  "private": true,
  "description": "Small production-minded appointment workflow demo built around Temporal",
  "engines": { "node": ">=20 <21" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/backend/server.js",
    "worker": "node dist/worker/worker.js",
    "dev": "tsx watch src/backend/server.ts",
    "dev:worker": "tsx watch src/worker/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "check": "npm run prisma:generate && npm run build && npm test"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@temporalio/activity": "1.13.2",
    "@temporalio/client": "1.13.2",
    "@temporalio/common": "1.13.2",
    "@temporalio/worker": "1.13.2",
    "@temporalio/workflow": "1.13.2",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "8.6.2",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "pino": "9.9.4",
    "pino-http": "10.5.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@temporalio/testing": "1.13.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.17",
    "prisma": "6.12.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
