{
  "name": "temporal-healthcare-appointments",
  "version": "1.0.0",
  "private": true,
  "description": "Small production-minded appointment workflow demo built around Temporal",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --require ./dist/src/instrumentation.js dist/src/backend/server.js",
    "worker": "node --require ./dist/src/instrumentation.js dist/src/worker/worker.js",
    "dev": "tsx watch src/backend/server.ts",
    "dev:worker": "tsx watch src/worker/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "node dist/prisma/seed.js",
    "prisma:seed:dev": "tsx prisma/seed.ts",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run tests/integration",
    "check": "npm run prisma:generate && npm run typecheck && npm test && npm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-prometheus": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/client": "6.12.0",
    "@prisma/instrumentation": "^6.12.0",
    "@temporalio/activity": "1.23.0",
    "@temporalio/client": "1.23.0",
    "@temporalio/common": "1.23.0",
    "@temporalio/interceptors-opentelemetry": "^1.23.0",
    "@temporalio/worker": "1.23.0",
    "@temporalio/workflow": "1.23.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "8.6.2",
    "helmet": "8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "9.0.2",
    "pino": "9.9.4",
    "pino-http": "10.5.0",
    "prisma": "6.12.0",
    "rate-limit-redis": "^6.0.1",
    "resend": "6.24.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@temporalio/testing": "1.23.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.17",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
